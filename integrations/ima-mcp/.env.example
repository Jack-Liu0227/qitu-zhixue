# 从 https://ima.qq.com/agent-interface 获取；仅保存在服务端，不提交 Git。
IMA_OPENAPI_CLIENTID=
IMA_OPENAPI_APIKEY=

# 用 npm run discover 查询后填入；多个知识库 ID 用英文逗号分隔。
IMA_KNOWLEDGE_BASE_IDS=

# 每个 Agent 一个独立随机 token，至少 32 字符。请替换为空对象中的实际配置。
# 例：{"math-agent":"随机生成的长token","planner-agent":"另一个随机生成的长token"}
MCP_CLIENT_TOKENS={}

HOST=127.0.0.1
PORT=8787

# 默认仅允许 localhost:8787 / 127.0.0.1:8787 / [::1]:8787。
# 通过反向代理访问时，追加实际域名，如 kb.example.com；不要使用 *。
MCP_ALLOWED_HOSTS=

# 服务端 Agent 不需要填写。仅在确有浏览器直连需求时指定完整 Origin。
MCP_ALLOWED_ORIGINS=
IMA_TIMEOUT_MS=20000
IMA_MAX_FILE_MB=50

# npm run smoke 使用的教材关键词。
IMA_SMOKE_QUERY=对数
