[Unit]
Description=Qitu student production frontend
After=network.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
# Runs from the canonical checkout. .next must be a production build
# (`bash tooling/start-qitu-services.sh build` with QITU_FRONTEND_MODE=production);
# `next start` crash-loops on dev artifacts or a missing BUILD_ID.
WorkingDirectory=/root/qitu-zhixue
Environment=PATH=/usr/local/bin:/usr/bin:/bin
Environment=NODE_ENV=production
Environment=NEXT_TELEMETRY_DISABLED=1
# Bound the V8 old space so one runaway server cannot push the box into OOM.
Environment=NODE_OPTIONS=--max-old-space-size=1024
Environment=HOST=127.0.0.1
Environment=PORT=3101
ExecStart=/usr/bin/pnpm --filter @qitu/student-center exec next start --hostname 127.0.0.1 --port 3101
Restart=always
RestartSec=5
KillMode=control-group
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
