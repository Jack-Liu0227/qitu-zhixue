# Public gateway port. Internal services must bind to loopback only.
QITU_PUBLIC_PORT=3000
QITU_BIND_HOST=127.0.0.1
QITU_AUTH_PORT=3100
QITU_STUDENT_PORT=3101
QITU_PARENT_PORT=3102
QITU_TEACHER_PORT=3103
QITU_ADMIN_PORT=3104
QITU_COMPANY_PORT=3105
QITU_API_PORT=4100

# Server-only secret: inject an authenticated loopback Redis URL in the private env file.
# REDIS_URL=redis://:PASSWORD@127.0.0.1:6379/0
REDIS_KEY_PREFIX=qitu

# 前端运行模式：dev（本地开发默认）或 production（服务器应用）。
# production 下脚本用 `next build` 产物跑 `next start`，并拒绝在缺 BUILD_ID 时启动；
# 每个前端常驻内存从 ≈450 MB 降到 ≈190 MB，是 7.6 GB 机器上避免 OOM 的关键开关。
# 切换后先 `bash tooling/start-qitu-services.sh build` 再 start/restart。
QITU_FRONTEND_MODE=dev

# 可选：常驻 node 进程的 V8 老年代上限（MB）。留空不限制；设上它可以防止单个服务
# 内存无限增长把整机拖到 OOM（建议 1024，约稳态内存的 5 倍余量）。
QITU_NODE_MAX_OLD_SPACE_MB=

# Optional M4 mastery timeline projection; disabled by default.
QITU_GRAPHITI_ENABLED=false
QITU_GRAPHITI_URL=http://127.0.0.1:4180
# Optional local process controls:
# QITU_WORKERS_ENABLED=false
# QITU_GRAPHITI_TOKEN is injected from a secret manager, never committed.
