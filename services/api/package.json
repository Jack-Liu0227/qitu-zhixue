{
  "name": "@qitu/api",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "nest start --watch",
    "prebuild": "pnpm --filter @qitu/database build",
    "build": "nest build",
    "lint": "node ../../tooling/lint-baseline.mjs",
    "pretypecheck": "pnpm --filter @qitu/database build",
    "typecheck": "tsc --noEmit",
    "test": "pnpm --filter @qitu/database build && pnpm --filter @qitu/infra build && tsc -p tsconfig.json --outDir .tmp/test-dist && node --test \".tmp/test-dist/**/*.test.js\""
  },
  "dependencies": {
    "@qitu/agent-memory": "workspace:*",
    "@qitu/contracts": "workspace:*",
    "@qitu/database": "workspace:*",
    "@qitu/infra": "workspace:*",
    "@qitu/ai-client": "workspace:*",
    "@qitu/model-runtime": "workspace:*",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "drizzle-orm": "^0.36.4",
    "pg": "^8.13.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.8.3"
  }
}
