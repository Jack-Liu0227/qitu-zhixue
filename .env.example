# 启途智学 · 环境变量模板
#
# 用法：复制为 `.env`（已被 .gitignore 忽略）后按需填写，**不要把填写后的文件提交**。
#   cp .env.example .env
#
# 约定：
#   - 本文件只放占位值，任何真实密钥都不允许进入仓库（AGENTS.md「安全」）。
#   - CI 的 Secret scan 会同时按“文件名”和“内容”两个维度扫描（.github/workflows/baseline.yml）。
#   - 服务端口另有模板：tooling/qitu-ports.env.example（由 tooling/start-qitu-services.sh 读取）。
#   - Graphiti 另见：tooling/graphiti.env.example。
#
# 相关文档：docs/admin/deployment.md、docs/admin/database.md、
#          docs/admin/model-registry.md、docs/admin/platform-governance.md

# ---------------------------------------------------------------------------
# 运行模式（必填）
# ---------------------------------------------------------------------------
# live  = 真实数据库 + 真实模型调用（生产 / 联调）
# demo  = 允许演示数据
# test  = 测试专用，禁止外部副作用
QITU_DATA_MODE=live

# ---------------------------------------------------------------------------
# 数据库（live / test 模式必填）
# ---------------------------------------------------------------------------
# Postgres 是唯一 system-of-record；迁移只向前（forward-only）。
# 本地 peer 认证示例（socket 连接，无密码）：
#   DATABASE_URL=postgresql:///qitu_dev?host=/var/run/postgresql
# 带口令示例（口令只写在本文件、绝不提交）：
#   DATABASE_URL=postgresql://qitu:PUT_DB_PASSWORD_HERE@127.0.0.1:5432/qitu_dev
DATABASE_URL=postgresql:///qitu_dev?host=/var/run/postgresql

# ---------------------------------------------------------------------------
# API 服务（services/api）
# ---------------------------------------------------------------------------
HOST=127.0.0.1
PORT=4100
NODE_ENV=development
# 仓库根目录；本地开发一般无需设置
# QITU_PROJECT_ROOT=/absolute/path/to/qitu-zhixue

# ---------------------------------------------------------------------------
# 模型凭据主密钥（写模型 provider 配置时必填）
# ---------------------------------------------------------------------------
# AES-256-GCM 主密钥，32 字节（64 位十六进制或 base64）。
# 生成：openssl rand -base64 32
# 只从环境变量读取；绝不写入仓库 / 迁移 / 日志。
# 未配置时「读取」模型配置可用，但无法解密已存密文，也无法验证鉴权。
QITU_MODEL_SECRET_KEY=PUT_32_BYTE_KEY_HERE

# 仅本地联调：把真实模型 API Key 直接放进环境（生产请走管理端写入密文）
# 值形如 `sk-` 开头的字符串；这里只写占位符，**不要把真实 Key 粘进来**。
# QITU_LIVE_MODEL_API_KEY=<仅本地联调时填写，勿提交>

# ---------------------------------------------------------------------------
# Redis（可选）
# ---------------------------------------------------------------------------
# 未配置时 live 模式会在首次请求时 fail-fast，属预期行为。
# REDIS_URL=redis://127.0.0.1:6379
# REDIS_KEY_PREFIX=qitu
# REDIS_CACHE_TTL_MS=60000
# REDIS_LOCK_TTL_MS=30000

# ---------------------------------------------------------------------------
# 会话 Cookie
# ---------------------------------------------------------------------------
# 生产（HTTPS）必须为 true；本地 HTTP 联调置 false。
SESSION_COOKIE_SECURE=false
# 仅供本地调试的前端免登录开关，**绝不可在生产启用**。
# NEXT_PUBLIC_DEV_BYPASS_AUTH=false

# ---------------------------------------------------------------------------
# 异步任务（outbox / workers）
# ---------------------------------------------------------------------------
# 提醒投递默认关闭；打开前先确认 workers 已随服务启动。
QITU_REMINDER_DELIVERY_ENABLED=false

# ---------------------------------------------------------------------------
# 掌握度时间线投影（Graphiti，可选）
# ---------------------------------------------------------------------------
# 默认关闭；Postgres 为权威存储，Graphiti 仅是可重建的异步投影（ADR 0009）。
QITU_GRAPHITI_ENABLED=false
# QITU_GRAPHITI_URL=http://127.0.0.1:4180
# QITU_GRAPHITI_TOKEN=PUT_TOKEN_HERE

# ---------------------------------------------------------------------------
# 前端构建期变量
# ---------------------------------------------------------------------------
# 前端访问 API 的同源代理目标；留空则走各应用 next.config.ts 的 rewrites。
# QITU_API_ORIGIN=http://127.0.0.1:4100

# ---------------------------------------------------------------------------
# 部署脚本（tooling/start-qitu-services.sh）使用
# ---------------------------------------------------------------------------
# QITU_BIND_HOST=127.0.0.1
# QITU_SECRET_ENV_FILE=/path/to/.runtime/qitu/model-secret.env
# QITU_RUNTIME_DIR=/path/to/.runtime/qitu
