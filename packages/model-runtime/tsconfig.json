{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": true,
    "rootDir": "src",
    "resolveJsonModule": true,
    "noUncheckedIndexedAccess": false
  },
  "include": [
    "src/index.ts",
    "src/runtime.ts",
    "src/**/*.test.ts"
  ],
  "exclude": [
    "dist",
    "node_modules"
  ]
}
