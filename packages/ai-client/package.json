{
  "name": "@qitu/ai-client",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./pedagogy": {
      "types": "./dist/pedagogy/index.d.ts",
      "default": "./dist/pedagogy/index.js"
    },
    "./context": {
      "types": "./dist/context/index.d.ts",
      "default": "./dist/context/index.js"
    },
    "./escalation": {
      "types": "./dist/escalation/index.d.ts",
      "default": "./dist/escalation/index.js"
    },
    "./agent-runtime": {
      "types": "./dist/agent-runtime.d.ts",
      "default": "./dist/agent-runtime.js"
    },
    "./agent-context-adapter": {
      "types": "./dist/agent-context-adapter.d.ts",
      "default": "./dist/agent-context-adapter.js"
    },
    "./qitu-sdk": {
      "types": "./dist/qitu-sdk.d.ts",
      "default": "./dist/qitu-sdk.js"
    },
    "./curriculum": {
      "types": "./dist/curriculum.d.ts",
      "default": "./dist/curriculum.js"
    },
    "./context-packet": {
      "types": "./dist/context-packet.d.ts",
      "default": "./dist/context-packet.js"
    },
    "./mastery": {
      "types": "./dist/mastery/index.d.ts",
      "default": "./dist/mastery/index.js"
    },
    "./questions": {
      "types": "./dist/questions/index.d.ts",
      "default": "./dist/questions/index.js"
    },
    "./grading": {
      "types": "./dist/grading/index.d.ts",
      "default": "./dist/grading/index.js"
