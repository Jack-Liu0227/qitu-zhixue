{
  "name": "@qitu/ai-client",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./pedagogy": {
      "types": "./dist/pedagogy/index.d.ts",
      "default": "./dist/pedagogy/index.js"
    },
    "./context": {
      "types": "./dist/context/index.d.ts",
      "default": "./dist/context/index.js"
    },
    "./escalation": {
      "types": "./dist/escalation/index.d.ts",
      "default": "./dist/escalation/index.js"
    },
    "./qitu-sdk": {
      "types": "./dist/qitu-sdk.d.ts",
      "default": "./dist/qitu-sdk.js"
    },
    "./sdk": {
      "types": "./dist/sdk.d.ts",
      "default": "./dist/sdk.js"
    },
    "./curriculum": {
      "types": "./dist/curriculum.d.ts",
      "default": "./dist/curriculum.js"
    },
    "./context-packet": {
      "types": "./dist/context-packet.d.ts",
      "default": "./dist/context-packet.js"
    },
    "./mastery": {
      "types": "./dist/mastery/index.d.ts",
      "default": "./dist/mastery/index.js"
    },
    "./questions": {
      "types": "./dist/questions/index.d.ts",
      "default": "./dist/questions/index.js"
    },
    "./grading": {
      "types": "./dist/grading/index.d.ts",
      "default": "./dist/grading/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "node -e \"console.log('ai-client: lint placeholder')\"",
    "typecheck": "tsc --noEmit",
    "test": "pnpm build && node --input-type=module -e \"const sdk = await import('./dist/sdk.test.js'); const mastery = await import('./dist/mastery/mastery.test.js'); const questions = await import('./dist/questions/questions.test.js'); const grading = await import('./dist/grading/grading.test.js'); const qitu = await import('./dist/qitu-sdk.test.js'); await qitu.runQituSDKAssertions(); await sdk.runTutorSdkAssertions(); mastery.runMasteryAssertions(); questions.runQuestionAssertions(); grading.runGradingAssertions();\""
  },
  "dependencies": {
    "@qitu/contracts": "workspace:*"
  }
}
