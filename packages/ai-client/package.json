{
  "name": "@qitu/ai-client",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./pedagogy": {
      "types": "./dist/pedagogy/index.d.ts",
      "default": "./dist/pedagogy/index.js"
    },
    "./context": {
      "types": "./dist/context/index.d.ts",
      "default": "./dist/context/index.js"
    },
    "./escalation": {
      "types": "./dist/escalation/index.d.ts",
      "default": "./dist/escalation/index.js"
    },
    "./sdk": {
      "types": "./dist/sdk.d.ts",
      "default": "./dist/sdk.js"
    },
    "./curriculum": {
      "types": "./dist/curriculum.d.ts",
      "default": "./dist/curriculum.js"
    },
    "./context-packet": {
      "types": "./dist/context-packet.d.ts",
      "default": "./dist/context-packet.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "node -e \"console.log('ai-client: lint placeholder')\"",
    "typecheck": "tsc --noEmit",
    "test": "pnpm build && node --input-type=module -e \"import('./dist/sdk.test.js').then(({ runTutorSdkAssertions }) => runTutorSdkAssertions())\""
  },
  "dependencies": {
    "@qitu/contracts": "workspace:*"
  }
